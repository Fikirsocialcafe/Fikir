{%- layout none -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ 'gift_card.title' | t }} · Fikir Social Café</title>
  <style>:root{--cream:{{ settings.color_cream }};--ink:{{ settings.color_ink }};--ethiopia:{{ settings.color_ethiopia }};--kenya:{{ settings.color_kenya }};--uganda:{{ settings.color_uganda }};}</style>
  {{ 'base.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body>
  <main class="password-page">
    <div>
      <img src="{{ 'logo-fikir-social-cafe.png' | asset_url }}" alt="Fikir Social Café" width="120" height="196">
      <h1 class="h2">{{ 'gift_card.title' | t }}</h1>
      <p class="h1">{{ gift_card.balance | money }}</p>
      <p class="lead">{{ 'gift_card.code' | t }}: <strong>{{ gift_card.code | format_code }}</strong></p>
      <a class="button" href="{{ shop.url }}">{{ 'cart.continue' | t }}</a>
    </div>
  </main>
</body>
</html>

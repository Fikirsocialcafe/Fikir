<div class="cart-summary">
  {%- for discount in cart.cart_level_discount_applications -%}
    <div class="cart-summary__row discount-line"><span>{{ discount.title }}</span><span>−{{ discount.total_allocated_amount | money }}</span></div>
  {%- endfor -%}
  {%- if cart.total_discount > 0 -%}
    <div class="cart-summary__row discount-line"><span>{{ 'cart.savings' | t }}</span><span>−{{ cart.total_discount | money }}</span></div>
  {%- endif -%}
  <div class="cart-summary__row cart-summary__total"><span>{{ 'cart.subtotal' | t }}</span><span>{{ cart.total_price | money }}</span></div>
  <p class="small muted">{{ 'cart.taxes_shipping' | t }}</p>
  {%- if form_mode == 'page' -%}
    <button type="submit" name="checkout" form="cart-form" class="button button--full">{{ 'cart.checkout' | t }}</button>
  {%- else -%}
    <a href="/checkout" class="button button--full">{{ 'cart.checkout' | t }}</a>
    <a href="{{ routes.cart_url }}" class="small" style="display:block;text-align:center;margin-top:12px">{{ 'cart.view_cart' | t }}</a>
  {%- endif -%}
  <p class="small muted center" style="margin-top:12px">{{ 'cart.bulk_hint' | t }}</p>
</div>

{%- liquid
  assign threshold = settings.free_shipping_threshold | times: 100
  assign remaining = threshold | minus: cart.total_price
  assign pct = cart.total_price | times: 100 | divided_by: threshold
  if pct > 100
    assign pct = 100
  endif
-%}
<div class="shipping-bar">
  {%- if remaining > 0 -%}
    {%- assign remaining_money = remaining | money -%}
    {{ 'cart.shipping_remaining_html' | t: amount: remaining_money }}
  {%- else -%}
    {{ 'cart.shipping_free' | t }}
  {%- endif -%}
  <div class="shipping-bar__track"><div class="shipping-bar__fill" style="width: {{ pct }}%"></div></div>
</div>

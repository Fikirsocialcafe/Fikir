<section class="section">
  <div class="page-width">
    <h1 class="h2">{{ blog.title }}</h1>
    {%- paginate blog.articles by 12 -%}
      <div class="grid grid--3" style="margin-top:32px">
        {%- for article in blog.articles -%}
          <a class="card" href="{{ article.url }}">
            <div class="card__media">{%- if article.image -%}{{ article.image | image_url: width: 800 | image_tag: loading: 'lazy' }}{%- endif -%}</div>
            <div class="card__body"><span class="card__origin">{{ article.published_at | date: format: 'date' }}</span><h3 class="card__title">{{ article.title }}</h3></div>
          </a>
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}<div class="pagination">{{ paginate | default_pagination }}</div>{%- endif -%}
    {%- endpaginate -%}
  </div>
</section>
{% schema %}
{ "name": "Blog", "settings": [] }
{% endschema %}

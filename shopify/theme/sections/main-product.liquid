{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign accent = ''
  capture accent
    render 'accent-class', product: product
  endcapture
  assign has_plans = false
  if product.selling_plan_groups.size > 0
    assign has_plans = true
  endif
  assign is_subscription = false
  if product.tags contains 'suscripcion'
    assign is_subscription = true
  endif
  assign has_grind_option = false
  for option in product.options
    if option == 'Molienda' or option == 'Grind'
      assign has_grind_option = true
    endif
  endfor
-%}
<section class="page-width {{ accent | strip }}" data-product>
  <div class="product">
    <div class="product__gallery">
      <div class="product__main-image">
        {%- assign main = current_variant.featured_media | default: product.featured_media -%}
        {%- if main -%}
          {{ main | image_url: width: 1400 | image_tag: data-main-image: '', loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 860px) 55vw, 100vw', widths: '600, 900, 1200, 1400', alt: main.alt | default: product.title }}
        {%- endif -%}
      </div>
      {%- if product.media.size > 1 -%}
        <div class="product__thumbs">
          {%- for media in product.media -%}
            <button type="button" data-thumb="{{ media | image_url: width: 1400 }}" data-srcset="" aria-current="{% if media.id == main.id %}true{% else %}false{% endif %}" aria-label="{{ 'product.view_image' | t: number: forloop.index }}">
              {{ media | image_url: width: 160 | image_tag: loading: 'lazy', alt: media.alt | default: product.title }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="product__info">
      <span class="eyebrow">
        {%- if product.metafields.custom.pais != blank -%}{{ product.metafields.custom.pais }} · {{ product.metafields.custom.region }}{%- else -%}{{ product.type }}{%- endif -%}
      </span>
      <h1 class="product__title h2">{{ product.title }}</h1>
      {%- if product.metafields.custom.notas != blank -%}
        <p class="product__notes notes">{{ product.metafields.custom.notas }}</p>
      {%- endif -%}
      {%- if product.metafields.custom.perfil != blank -%}
        <ul class="badge-list">
          <li>{{ product.metafields.custom.proceso }}</li>
          <li>SCA {{ product.metafields.custom.sca }}</li>
          <li>{{ 'product.medium_roast' | t }}</li>
        </ul>
      {%- endif -%}

      <div class="product__price"><span data-price>{{ current_variant.price | money }}</span>
        {%- if current_variant.compare_at_price > current_variant.price -%}<s>{{ current_variant.compare_at_price | money }}</s>{%- endif -%}
      </div>
      <p class="product__tax">{{ 'product.tax_included' | t }}{% if is_subscription %} · {{ 'product.shipping_included' | t }}{% endif %}</p>

      {%- form 'product', product, data-product-form: '', novalidate: 'novalidate' -%}
        <input type="hidden" name="id" value="{{ current_variant.id }}">

        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            <fieldset class="option" data-option>
              <legend>{{ option.name }}</legend>
              <div class="pills">
                {%- for value in option.values -%}
                  <label class="pill">
                    <input type="radio" name="option-{{ forloop.parentloop.index0 }}" value="{{ value | escape }}" {% if option.selected_value == value %}checked{% endif %}>
                    <span>{{ value }}</span>
                  </label>
                {%- endfor -%}
              </div>
              {%- if option.name == 'Molienda' or option.name == 'Grind' -%}
                <p class="option__help" data-grind-help='{{ 'product.grind_help_json' | t }}'></p>
              {%- endif -%}
            </fieldset>
          {%- endfor -%}
        {%- endunless -%}

        {%- unless has_grind_option or product.tags contains 'sin-molienda' -%}
          <fieldset class="option" data-grind-property>
            <legend>{{ 'product.grind_label' | t }}</legend>
            <div class="pills">
              {%- assign grind_keys = 'grano,espresso,italiana,filtro,prensa' | split: ',' -%}
              {%- assign grind_values = 'Grano|Espresso|Italiana|Filtro / V60|Prensa francesa / Cold brew' | split: '|' -%}
              {%- for key in grind_keys -%}
                {%- assign grind_key = 'product.grind_' | append: key -%}
                <label class="pill">
                  <input type="radio" name="properties[Molienda]" value="{{ grind_values[forloop.index0] }}" {% if forloop.first %}checked{% endif %}>
                  <span>{{ grind_key | t }}</span>
                </label>
              {%- endfor -%}
            </div>
            <p class="option__help" data-grind-help='{{ 'product.grind_help_json' | t }}'></p>
          </fieldset>
        {%- endunless -%}

        {%- if has_plans -%}
          <div class="purchase-type">
            {%- unless product.requires_selling_plan -%}
              <label><input type="radio" name="purchase_type" value="once"><span><strong>{{ 'product.one_time' | t }}</strong></span></label>
            {%- endunless -%}
            <label>
              <input type="radio" name="purchase_type" value="subscription" checked>
              <span style="flex:1"><strong>{{ 'product.subscribe' | t }}</strong><br><span class="small muted">{{ 'product.subscribe_help' | t }}</span>
                <select name="selling_plan" aria-label="{{ 'product.frequency' | t }}">
                  {%- for group in product.selling_plan_groups -%}
                    {%- for plan in group.selling_plans -%}
                      <option value="{{ plan.id }}" {% if forloop.first %}selected{% endif %}>{{ plan.name }}</option>
                    {%- endfor -%}
                  {%- endfor -%}
                </select>
              </span>
            </label>
          </div>
        {%- elsif is_subscription -%}
          <p class="notice small">{{ 'product.subscription_pending' | t }}</p>
        {%- endif -%}

        <div class="buy-row">
          <div class="qty">
            <button type="button" data-qty="minus" aria-label="{{ 'cart.decrease' | t }}">−</button>
            <input type="number" name="quantity" value="1" min="1" aria-label="{{ 'cart.quantity' | t }}">
            <button type="button" data-qty="plus" aria-label="{{ 'cart.increase' | t }}">+</button>
          </div>
          <button type="submit" class="button" {% unless current_variant.available %}disabled{% endunless %}>
            {%- if current_variant.available -%}{{ 'product.add_to_cart' | t }}{%- else -%}{{ 'product.sold_out' | t }}{%- endif -%}
          </button>
        </div>
        <p class="small" data-form-status role="status" aria-live="polite"></p>
      {%- endform -%}

      <ul class="perks">
        <li>{% render 'icon', name: 'truck' %}<span>{{ 'product.perk_shipping' | t: amount: settings.free_shipping_threshold }}</span></li>
        {%- if product.tags contains 'bolsa' -%}<li>{% render 'icon', name: 'tag' %}<span>{{ 'product.perk_bulk' | t }}</span></li>{%- endif -%}
        <li>{% render 'icon', name: 'heart' %}<span>
          {%- if product.metafields.custom.pais != blank -%}{{ 'product.perk_impact_country' | t: country: product.metafields.custom.pais }}{%- else -%}{{ 'product.perk_impact' | t }}{%- endif -%}
        </span></li>
      </ul>

      <div class="rte muted">{{ product.description }}</div>

      <div class="accordion" style="margin-top:28px">
        {%- if product.metafields.custom.pais != blank -%}
          <details open>
            <summary>{{ 'product.sheet' | t }}</summary>
            <div class="accordion__content">
              <dl class="spec">
                <dt>{{ 'product.spec_country' | t }}</dt><dd>{{ product.metafields.custom.pais }}</dd>
                <dt>{{ 'product.spec_region' | t }}</dt><dd>{{ product.metafields.custom.region }}</dd>
                <dt>{{ 'product.spec_producer' | t }}</dt><dd>{{ product.metafields.custom.productor }}</dd>
                <dt>{{ 'product.spec_altitude' | t }}</dt><dd>{{ product.metafields.custom.altitud }}</dd>
                <dt>{{ 'product.spec_variety' | t }}</dt><dd>{{ product.metafields.custom.variedad }}</dd>
                <dt>{{ 'product.spec_process' | t }}</dt><dd>{{ product.metafields.custom.proceso }}</dd>
                <dt>{{ 'product.spec_harvest' | t }}</dt><dd>{{ product.metafields.custom.cosecha }}</dd>
                <dt>{{ 'product.spec_score' | t }}</dt><dd>{{ product.metafields.custom.sca }}</dd>
                <dt>{{ 'product.spec_profile' | t }}</dt><dd>{{ product.metafields.custom.perfil }}</dd>
              </dl>
            </div>
          </details>
        {%- endif -%}
        <details>
          <summary>{{ 'product.grind_guide' | t }}</summary>
          <div class="accordion__content">{{ 'product.grind_table_html' | t }}</div>
        </details>
        <details>
          <summary>{{ 'product.storage' | t }}</summary>
          <div class="accordion__content">{{ 'product.storage_text' | t }}</div>
        </details>
        <details>
          <summary>{{ 'product.shipping' | t }}</summary>
          <div class="accordion__content">{{ 'product.shipping_text' | t: amount: settings.free_shipping_threshold }}</div>
        </details>
      </div>
    </div>
  </div>
  <div class="sticky-buy" data-sticky-buy aria-hidden="true">
    <div class="sticky-buy__info">
      <span class="sticky-buy__title">{{ product.title }}</span>
      <span class="sticky-buy__price" data-sticky-price>{{ current_variant.price | money }}</span>
    </div>
    <button type="button" class="button" data-sticky-add tabindex="-1">{{ 'product.sticky_add' | t }}</button>
  </div>
  <script type="application/json" data-variants>
    [{%- for v in product.variants -%}{"id": {{ v.id }}, "available": {{ v.available }}, "price": {{ v.price | money | json }}, "options": {{ v.options | json }}, "plans": { {%- for a in v.selling_plan_allocations -%}"{{ a.selling_plan.id }}": {{ a.price | money | json }}{% unless forloop.last %},{% endunless %}{%- endfor -%} }}{% unless forloop.last %},{% endunless %}{%- endfor -%}]
  </script>
  {%- liquid
    assign ld_url = request.origin | append: product.url
    assign ld_images = ''
    for media in product.media limit: 6
      if media.media_type == 'image'
        assign ld_img = media | image_url: width: 1200
        assign ld_images = ld_images | append: 'https:' | append: ld_img | append: '|'
      endif
    endfor
    assign ld_images = ld_images | split: '|'
    assign ld_valid_until = 'now' | date: '%s' | plus: 31536000 | date: '%Y-%m-%d'
  -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org/",
      "@type": "Product",
      "@id": {{ ld_url | append: '#product' | json }},
      "url": {{ ld_url | json }},
      "name": {{ product.title | json }},
      "image": {{ ld_images | json }},
      "description": {{ product.description | strip_html | strip | json }},
      "brand": { "@type": "Brand", "name": "Fikir Social Café" },
      "manufacturer": { "@id": {{ request.origin | append: '/#organization' | json }} },
      "category": {{ product.type | json }},
      {%- if product.metafields.custom.pais != blank %}
      "countryOfOrigin": { "@type": "Country", "name": {{ product.metafields.custom.pais.value | json }} },
      "additionalProperty": [
        {%- assign ld_props = 'region,productor,altitud,variedad,proceso,cosecha,sca,notas,perfil' | split: ',' -%}
        {%- assign ld_names = 'Región,Productor,Altitud,Variedad,Proceso,Cosecha,Puntuación SCA,Notas de cata,Perfil' | split: ',' -%}
        {%- assign ld_first = true -%}
        {%- for key in ld_props -%}
          {%- assign ld_value = product.metafields.custom[key].value -%}
          {%- if ld_value != blank -%}
            {%- unless ld_first %},{% endunless %}
            { "@type": "PropertyValue", "name": {{ ld_names[forloop.index0] | json }}, "value": {{ ld_value | json }} }
            {%- assign ld_first = false -%}
          {%- endif -%}
        {%- endfor %}
      ],
      {%- endif %}
      {%- if current_variant.sku != blank %}
      "sku": {{ current_variant.sku | json }},
      {%- endif %}
      "offers": [
        {%- for v in product.variants %}
        {
          "@type": "Offer",
          "url": {{ ld_url | append: '?variant=' | append: v.id | json }},
          "name": {{ v.title | json }},
          {%- if v.sku != blank %}"sku": {{ v.sku | json }},{% endif %}
          "price": {{ v.price | divided_by: 100.0 | json }},
          "priceCurrency": {{ cart.currency.iso_code | json }},
          "priceValidUntil": {{ ld_valid_until | json }},
          "itemCondition": "https://schema.org/NewCondition",
          "availability": "https://schema.org/{% if v.available %}InStock{% else %}OutOfStock{% endif %}",
          "seller": { "@id": {{ request.origin | append: '/#organization' | json }} },
          "shippingDetails": {
            "@type": "OfferShippingDetails",
            "shippingRate": { "@type": "MonetaryAmount", "value": {% if product.tags contains 'suscripcion' or v.price >= 5000 %}0{% else %}5.9{% endif %}, "currency": "EUR" },
            "shippingDestination": { "@type": "DefinedRegion", "addressCountry": "ES" },
            "deliveryTime": {
              "@type": "ShippingDeliveryTime",
              "handlingTime": { "@type": "QuantitativeValue", "minValue": 1, "maxValue": 2, "unitCode": "DAY" },
              "transitTime": { "@type": "QuantitativeValue", "minValue": 2, "maxValue": 3, "unitCode": "DAY" }
            }
          },
          "hasMerchantReturnPolicy": {
            "@type": "MerchantReturnPolicy",
            "applicableCountry": "ES",
            "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
            "merchantReturnDays": 14,
            "returnMethod": "https://schema.org/ReturnByMail",
            "returnFees": "https://schema.org/ReturnFeesCustomerResponsibility"
          }
        }{% unless forloop.last %},{% endunless %}
        {%- endfor %}
      ]
    }
  </script>
</section>
{% schema %}
{ "name": "Producto", "settings": [] }
{% endschema %}

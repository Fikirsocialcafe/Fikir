<section class="collection-hero section--deep">
  <div class="page-width">
    <span class="eyebrow">{{ 'collection.eyebrow' | t }}</span>
    <h1>{% if collection.handle == 'all' %}{{ 'collection.all_heading' | t }}{% else %}{{ collection.title }}{% endif %}</h1>
    {%- if collection.description != blank -%}<div class="lead">{{ collection.description }}</div>{%- endif -%}
  </div>
</section>
<section class="section section--tight">
  <div class="page-width">
    <nav class="collection-nav" aria-label="{{ 'collection.nav' | t }}">
      <a href="{{ routes.all_products_collection_url }}" {% if collection.handle == 'all' %}aria-current="page"{% endif %}>{{ 'collection.all' | t }}</a>
      {%- assign handles = section.settings.handles | split: ',' -%}
      {%- for handle in handles -%}
        {%- assign c = collections[handle] -%}
        {%- if c != blank -%}<a href="{{ c.url }}" {% if c.handle == collection.handle %}aria-current="page"{% endif %}>{{ c.title }}</a>{%- endif -%}
      {%- endfor -%}
    </nav>
    {%- paginate collection.products by 24 -%}
      {%- if collection.products.size > 0 -%}
        <div class="grid grid--4">
          {%- if collection.handle == 'all' -%}
            {%- comment -%}Orden de la tienda: orígenes, regalos, suscripción y el resto{%- endcomment -%}
            {%- assign shown_ids = '' -%}
            {%- assign tag_order = 'origen,regalo,suscripcion' | split: ',' -%}
            {%- for tag in tag_order -%}
              {%- for product in collection.products -%}
                {%- assign pid = product.id | append: ',' -%}
                {%- if product.tags contains tag -%}
                  {%- unless shown_ids contains pid -%}
                    {% render 'product-card', product: product %}
                    {%- assign shown_ids = shown_ids | append: pid -%}
                  {%- endunless -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endfor -%}
            {%- for product in collection.products -%}
              {%- assign pid = product.id | append: ',' -%}
              {%- unless shown_ids contains pid -%}{% render 'product-card', product: product %}{%- endunless -%}
            {%- endfor -%}
          {%- else -%}
            {%- for product in collection.products -%}{% render 'product-card', product: product %}{%- endfor -%}
          {%- endif -%}
        </div>
      {%- else -%}
        <p class="empty-state muted">{{ 'collection.empty' | t }}</p>
      {%- endif -%}
      {%- if paginate.pages > 1 -%}<div class="pagination">{{ paginate | default_pagination }}</div>{%- endif -%}
    {%- endpaginate -%}
  </div>
</section>
{% schema %}
{
  "name": "Colección",
  "settings": [
    { "type": "text", "id": "handles", "label": "Colecciones en el filtro (handles separados por comas)", "default": "cafes-de-origen,packs-y-regalos,suscripcion" }
  ]
}
{% endschema %}

{%- assign k = section.settings.key -%}
<section class="section{% if section.settings.background == 'deep' %} section--deep{% endif %}">
  <div class="page-width page-width--narrow">
    <div class="center" style="margin-bottom:32px">
      <span class="eyebrow">{{ 'faq.eyebrow' | t }}</span>
      <h2>{{ k | append: '.heading' | t }}</h2>
    </div>
    <div class="accordion">
      {%- for i in (1..section.settings.count) -%}
        {%- capture q -%}{{ k }}.q{{ i }}{%- endcapture -%}
        {%- capture a -%}{{ k }}.a{{ i }}{%- endcapture -%}
        <details>
          <summary>{{ q | t }}</summary>
          <div class="accordion__content">{{ a | t }}</div>
        </details>
      {%- endfor -%}
      {%- for block in section.blocks -%}
        <details {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question }}</summary>
          <div class="accordion__content rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- comment -%} FAQPage para Google y asistentes de IA, con las mismas preguntas que se ven en la página. {%- endcomment -%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {%- assign faq_first = true -%}
      {%- for i in (1..section.settings.count) -%}
        {%- capture q -%}{{ k }}.q{{ i }}{%- endcapture -%}
        {%- capture a -%}{{ k }}.a{{ i }}{%- endcapture -%}
        {%- unless faq_first %},{% endunless %}
        { "@type": "Question", "name": {{ q | t | strip_html | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ a | t | strip_html | json }} } }
        {%- assign faq_first = false -%}
      {%- endfor -%}
      {%- for block in section.blocks -%}
        {%- if block.settings.question != blank and block.settings.answer != blank -%}
          {%- unless faq_first %},{% endunless %}
          { "@type": "Question", "name": {{ block.settings.question | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} } }
          {%- assign faq_first = false -%}
        {%- endif -%}
      {%- endfor %}
    ]
  }
</script>
{% schema %}
{
  "name": "Preguntas frecuentes",
  "settings": [
    { "type": "text", "id": "key", "label": "Bloque de textos traducidos", "default": "faq.home" },
    { "type": "range", "id": "count", "label": "Preguntas traducidas a mostrar", "min": 0, "max": 12, "step": 1, "default": 6 },
    { "type": "select", "id": "background", "label": "Fondo", "default": "cream", "options": [{ "value": "cream", "label": "Crema" }, { "value": "deep", "label": "Crema oscuro" }] }
  ],
  "blocks": [
    { "type": "question", "name": "Pregunta", "settings": [
      { "type": "text", "id": "question", "label": "Pregunta" },
      { "type": "richtext", "id": "answer", "label": "Respuesta" }
    ] }
  ],
  "presets": [{ "name": "Preguntas frecuentes" }]
}
{% endschema %}

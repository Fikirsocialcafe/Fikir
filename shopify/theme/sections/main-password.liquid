<div class="password-page">
  <div>
    <img src="{{ 'logo-fikir-social-cafe.png' | asset_url }}" alt="Fikir Social Café" width="140" height="228">
    <h1 class="h2">{{ 'password.heading' | t }}</h1>
    <p class="lead">{{ 'password.text' | t }}</p>
    {%- form 'storefront_password', class: 'field', style: 'max-width:360px;margin:24px auto 0' -%}
      {%- if form.errors -%}<div class="notice notice--error">{{ form.errors | default_errors }}</div>{%- endif -%}
      <label for="password">{{ 'password.label' | t }}</label>
      <input type="password" name="password" id="password" autocomplete="current-password">
      <button class="button" type="submit" style="margin-top:10px">{{ 'password.enter' | t }}</button>
    {%- endform -%}
  </div>
</div>
{% schema %}
{ "name": "Contraseña", "settings": [] }
{% endschema %}

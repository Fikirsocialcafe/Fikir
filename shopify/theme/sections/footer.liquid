<footer class="footer">
  <div class="page-width">
    <div class="footer__grid">
      <div class="footer__brand">
        <img src="{{ 'ilustracion-fikir.png' | asset_url }}" alt="" width="52" height="92" loading="lazy">
        <p class="brand" style="font-size:1.1rem">Fikir Social Café</p>
        <p style="max-width:28em;opacity:.85">{% render 'text', value: section.settings.about, key: 'footer.about' %}</p>
      </div>
      <div>
        <h3>{{ 'footer.shop' | t }}</h3>
        <ul>{%- for link in section.settings.menu_shop.links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}</ul>
      </div>
      <div>
        <h3>{{ 'footer.info' | t }}</h3>
        <ul>{%- for link in section.settings.menu_info.links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}</ul>
      </div>
      <div>
        <h3>{{ 'footer.contact' | t }}</h3>
        <ul>
          <li><a href="mailto:{{ settings.contact_email }}">{{ settings.contact_email }}</a></li>
          {%- if settings.whatsapp != blank -%}<li><a href="https://wa.me/{{ settings.whatsapp }}" target="_blank" rel="noopener">WhatsApp</a></li>{%- endif -%}
          {%- if settings.instagram != blank -%}<li><a href="{{ settings.instagram }}" target="_blank" rel="noopener">Instagram</a></li>{%- endif -%}
          {%- if settings.linkedin != blank -%}<li><a href="{{ settings.linkedin }}" target="_blank" rel="noopener">LinkedIn</a></li>{%- endif -%}
          {%- if settings.tiktok != blank -%}<li><a href="{{ settings.tiktok }}" target="_blank" rel="noopener">TikTok</a></li>{%- endif -%}
        </ul>
        <div style="margin-top:18px">{% render 'localization', id: 'footer' %}</div>
      </div>
    </div>
    <div class="footer__bottom">
      <span>© {{ 'now' | date: '%Y' }} Fikir Social Café · {{ 'footer.legal_line' | t }}</span>
      <div class="payment-icons" aria-label="{{ 'footer.payments' | t }}">
        {%- for type in shop.enabled_payment_types -%}{{ type | payment_type_svg_tag }}{%- endfor -%}
      </div>
    </div>
  </div>
</footer>
{%- if settings.whatsapp != blank -%}
  <a class="whatsapp" href="https://wa.me/{{ settings.whatsapp }}" target="_blank" rel="noopener" aria-label="WhatsApp">{% render 'icon', name: 'whatsapp' %}</a>
{%- endif -%}
{% schema %}
{
  "name": "Pie de página",
  "settings": [
    { "type": "textarea", "id": "about", "label": "Texto de marca" },
    { "type": "link_list", "id": "menu_shop", "label": "Menú tienda", "default": "footer" },
    { "type": "link_list", "id": "menu_info", "label": "Menú información", "default": "footer" }
  ]
}
{% endschema %}

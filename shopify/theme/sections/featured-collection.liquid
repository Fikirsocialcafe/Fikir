{%- liquid
  assign collection = collections[section.settings.collection]
  assign limit = section.settings.limit
-%}
<section class="section{% if section.settings.background == 'deep' %} section--deep{% endif %}">
  <div class="page-width">
    <div class="section-header">
      <div>
        {%- if section.settings.eyebrow_key != blank or section.settings.eyebrow != blank -%}
          <span class="eyebrow">{% render 'text', value: section.settings.eyebrow, key: section.settings.eyebrow_key %}</span>
        {%- endif -%}
        <h2>{% render 'text', value: section.settings.heading, key: section.settings.heading_key %}</h2>
        {%- if section.settings.text_key != blank or section.settings.text != blank -%}
          <p class="lead">{% render 'text', value: section.settings.text, key: section.settings.text_key %}</p>
        {%- endif -%}
      </div>
      {%- if collection != blank -%}<a class="link-arrow" href="{{ collection.url }}">{{ 'general.view_all' | t }}</a>{%- endif -%}
    </div>
    <div class="grid grid--{{ section.settings.columns }}">
      {%- if collection != blank and collection.products_count > 0 -%}
        {%- for product in collection.products limit: limit -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        <p class="muted">{{ 'collection.empty' | t }}</p>
      {%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Colección destacada",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo" },
    { "type": "text", "id": "eyebrow_key", "label": "Clave de traducción del antetítulo" },
    { "type": "text", "id": "heading", "label": "Titular" },
    { "type": "text", "id": "heading_key", "label": "Clave de traducción del titular", "default": "home.featured.heading" },
    { "type": "textarea", "id": "text", "label": "Texto" },
    { "type": "text", "id": "text_key", "label": "Clave de traducción del texto" },
    { "type": "collection", "id": "collection", "label": "Colección" },
    { "type": "range", "id": "limit", "label": "Productos", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "select", "id": "columns", "label": "Columnas", "default": "4", "options": [{ "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" }] },
    { "type": "select", "id": "background", "label": "Fondo", "default": "cream", "options": [{ "value": "cream", "label": "Crema" }, { "value": "deep", "label": "Crema oscuro" }] }
  ],
  "presets": [{ "name": "Colección destacada" }]
}
{% endschema %}

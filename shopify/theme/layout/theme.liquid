<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_cream }}">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- else -%}
      <link rel="icon" type="image/png" href="{{ 'favicon-fikir.png' | asset_url }}">
    {%- endif -%}
    <title>
      {{ page_title }}
      {%- if current_tags %} · {{ current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} · {{ 'general.page' | t: page: current_page }}{% endif -%}
      {%- unless page_title contains 'Fikir' %} · Fikir Social Café{% endunless -%}
    </title>
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- else -%}
      <meta name="description" content="{{ 'general.meta_description' | t | escape }}">
    {%- endif -%}
    {% render 'meta-tags' %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Belleza&family=Lato:wght@400;700;900&display=swap" rel="stylesheet">
    <style>
      :root {
        --cream: {{ settings.color_cream }};
        --ink: {{ settings.color_ink }};
        --ethiopia: {{ settings.color_ethiopia }};
        --kenya: {{ settings.color_kenya }};
        --uganda: {{ settings.color_uganda }};
      }
    </style>
    {{ 'base.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
    {{ content_for_header }}
  </head>
  <body class="template-{{ template.name }}">
    <a class="skip-link" href="#main">{{ 'general.skip_to_content' | t }}</a>
    {% sections 'header-group' %}
    <main id="main" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>
    {% sections 'footer-group' %}
    {% section 'cart-drawer' %}
    <script>
      window.fikir = {
        routes: { cart_add: "{{ routes.cart_add_url }}", cart_change: "{{ routes.cart_change_url }}", cart: "{{ routes.cart_url }}", root: "{{ routes.root_url }}" },
        strings: { added: {{ 'cart.added' | t | json }}, error: {{ 'cart.error' | t | json }}, sold_out: {{ 'product.sold_out' | t | json }}, add: {{ 'product.add_to_cart' | t | json }} }
      };
    </script>
  </body>
</html>

<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Fikir Social Café</title>
    <link rel="icon" type="image/png" href="{{ 'favicon-fikir.png' | asset_url }}">
    <link href="https://fonts.googleapis.com/css2?family=Belleza&family=Lato:wght@400;700;900&display=swap" rel="stylesheet">
    <style>:root{--cream:{{ settings.color_cream }};--ink:{{ settings.color_ink }};--ethiopia:{{ settings.color_ethiopia }};--kenya:{{ settings.color_kenya }};--uganda:{{ settings.color_uganda }};}</style>
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="template-password">
    <main id="main">{{ content_for_layout }}</main>
  </body>
</html>
